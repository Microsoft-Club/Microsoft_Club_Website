PORT=5000
# Session pooler (recommended for the running API). Password: URL-encode special chars ($ -> %24).
# postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:database123@localhost:5432/mlsadb"
# Direct connection for Prisma migrate / db push (user is postgres, host db.<project-ref>.supabase.co)
DIRECT_URL="postgresql://postgres:database123@localhost:5432/mlsadb"
JWT_SECRET=replace-this-with-a-long-random-secret
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-before-starting"


# Cloudflare R2 Storage Configuration
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="microsoft-club-giki"
# Public CDN URL: custom domain (e.g. https://assets.yourdomain.com) or r2.dev (e.g. https://pub-xxxx.r2.dev)
R2_PUBLIC_DOMAIN="https://pub-2839c05f69c040768d61d9a74a3f536b.r2.dev"
# Optional alternative to Access Keys: Cloudflare API Token with R2 permissions
CLOUDFLARE_API_TOKEN=""

# Local author-image fallback during development only. Keep false in production.
ALLOW_LOCAL_IMAGE_UPLOADS=false
# Public backend URL used when local author images are enabled
BACKEND_PUBLIC_URL=http://localhost:5000

# Contact form email (Home page mail.app). For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=the Gmail address, SMTP_PASS=a Google "App password" (not the normal password).
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
# Inbox that receives website messages
CONTACT_TO_EMAIL=""
# Optional; defaults to SMTP_USER
CONTACT_FROM_EMAIL=""
