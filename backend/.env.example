PORT=5000
# Session pooler (recommended for the running API). Password: URL-encode special chars ($ -> %24).
# postgresql://postgres.<project-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require"
# Direct connection for Prisma migrate / db push (user is postgres, host db.<project-ref>.supabase.co)
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"
JWT_SECRET=supersecretjwtkeychangeit
ADMIN_EMAIL="mustafa.ak0305@gmail.com"
ADMIN_PASSWORD="19326MLSA@"


# Cloudflare R2 Storage Configuration
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="microsoft-club-assets"
# Public CDN URL: custom domain (e.g. https://assets.yourdomain.com) or r2.dev (e.g. https://pub-xxxx.r2.dev)
R2_PUBLIC_DOMAIN="https://pub-your-bucket-id.r2.dev"